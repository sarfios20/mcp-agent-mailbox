[Unit]
Description=SSH tunnel to the coordinated-agent mailbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -NT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 127.0.0.1:8765:127.0.0.1:8765 buzon-vps
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
