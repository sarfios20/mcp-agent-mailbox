[Unit]
Description=MCP mailbox between agents
After=network.target

[Service]
User={{.SystemUser}}
Group={{.SystemUser}}
ExecStart={{.BinaryPath}} serve --data {{.DataDir}} --port {{.Port}}
StateDirectory=mcp-agent-mailbox
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
